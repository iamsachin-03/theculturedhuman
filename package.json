{
  "name": "theculturedhuman",
  "version": "1.0.0",
  "private": true,
  "description": "The Cultured Human \u2014 an independent Indian cultural journal. Static site built with zero dependencies.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "test": "node --test test/*.test.mjs && npm run -s test:py",
    "test:py": "python3 -m unittest discover -s test -p 'test_*.py'",
    "serve": "node tools/serve.mjs",
    "dev": "node tools/build.mjs && node tools/serve.mjs",
    "new-place": "node tools/new-place.mjs"
  }
}
